# ─────────────────────────────────────────────────────────────────────────────
# POS Backend Environment Configuration
# COPY this to .env and fill in real values before deploying.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Django Core
DJANGO_SECRET_KEY=<generate-a-new-secret-key-here>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,38.45.94.56

# ── PRODUCTION: set DEBUG=False and configure your real domain below ──────────
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,38.45.94.56

# Database (MySQL)
DB_NAME=pos
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
# Optional single URL override (useful for containers/CI):
# DATABASE_URL=mysql://user:password@db:3306/pos
# DATABASE_URL=sqlite:////tmp/pos.sqlite3
DB_CONN_MAX_AGE=60

# Token expiry
API_TOKEN_MAX_AGE_DAYS=7
APP_TOKEN_MAX_AGE_DAYS=30

# CORS & CSRF (comma-separated if multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://38.45.94.56:4092
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:8000,http://38.45.94.56:4092,http://38.45.94.56:8092

# ── Cache / Redis (REQUIRED for 20K+ daily traffic) ───────────────────────────
# Install Redis on your server, then set this URL.
# Without this, caching falls back to in-process memory (not shared across workers).
# pip install redis django-redis  (already in requirements.txt)
# REDIS_URL=redis://localhost:6379/0

# Audit logging (forwarded IPs should only be trusted behind a sanitising proxy)
AUDIT_LOG_ENABLED=True
AUDIT_LOG_WORKERS=8
AUDIT_LOG_MAX_QUEUE=50000
AUDIT_TRUST_X_FORWARDED_FOR=False
AUDIT_GEO_LOOKUP_ENABLED=False
