# ─────────────────────────────────────────────────────────────────────────────
# POS Backend Environment Configuration
# COPY this to .env and fill in real values before deploying.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Django Core
DJANGO_SECRET_KEY=jfglx^+9i*=6n-f76xf+jk8uqt6jcbhg-o!1e=ny&=g&hteyxj
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,38.45.94.56

# ── PRODUCTION: set DEBUG=False and configure your real domain below ──────────
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,38.45.94.56

# Database
# Local development may use SQLite by omitting DB_ENGINE (when DEBUG=True).
# Production should set DB_ENGINE=django.db.backends.mysql.
DB_ENGINE=django.db.backends.mysql
DB_NAME=pos
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# CORS & CSRF (space-separated if multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://38.45.94.56:4092
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:8000,http://38.45.94.56:4092,http://38.45.94.56:8092

# ── API session / HTTPS ───────────────────────────────────────────────────────
API_TOKEN_MAX_AGE_DAYS=30
# DEBUG=False redirects HTTP to HTTPS by default. Disable only behind a trusted
# TLS-terminating proxy that performs the redirect itself.
# SECURE_SSL_REDIRECT=False

# ── Cache / Redis (REQUIRED for multi-worker production) ──────────────────────
# Without Redis, throttles/cache are local to one Gunicorn worker.
# REDIS_URL=redis://localhost:6379/0
